# Copy to .env and adjust before running `docker compose up`.
# Never commit a populated .env.

# ---- Database ---------------------------------------------------------------
DB_PASSWORD=mysecretpassword

# ---- JWT --------------------------------------------------------------------
# MUST be at least 32 bytes: the application refuses to start with a shorter secret
# because HS256 requires a 256-bit key. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list. A literal "*" is accepted for local development only and
# is never combined with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Spring profile ---------------------------------------------------------
# Leave blank for local development; set to `prod` for a hardened deployment.
SPRING_PROFILES_ACTIVE=

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_PERIOD_SECONDS=60
# true  = allow traffic when Redis is unavailable (availability first, free tiers)
# false = reject with 429 when Redis is unavailable (enforcement first, paid tiers)
RATE_LIMIT_FAIL_OPEN=true

# ---- Gateway / SSRF controls ------------------------------------------------
GATEWAY_CONNECT_TIMEOUT_MS=10000
GATEWAY_READ_TIMEOUT_MS=30000
GATEWAY_MAX_RESPONSE_BYTES=1048576
# Comma-separated upstream host allow-list. Empty means "any host that resolves to a
# routable, non-private address". Set this in production.
GATEWAY_ALLOWED_HOSTS=

# ---- Jobs and retention -----------------------------------------------------
JOBRUNR_SERVER_ENABLED=true
JOBRUNR_DASHBOARD_ENABLED=true
USAGE_RETENTION_DAYS=90

# ---- Ops --------------------------------------------------------------------
ACTUATOR_EXPOSURE=health,info
MAX_PAGE_SIZE=100
